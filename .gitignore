# Generated verification evidence remains local; keep tools and compact summaries.
/verification/**/*.png
/verification/**/*.jpg
/verification/**/*.jpeg
/verification/**/*.log
/verification/**/report.json
/verification/**/failures.json

# Intermediate 2026-10-07 QA iterations are retained locally, not published as release evidence.
/verification/ui-scale-qa-v04-ui-fix-20261007/
/verification/ui-scale-qa-v04-ui-fix-20261007-final/
/verification/ui-scale-qa-v04-ui-fix-20261007-verified/
/verification/ui-scale-qa-v04-ui-fix-20261007-release/*/summary.txt

# Unity cache, builds, and user settings are covered by AeroSim/.gitignore.
