{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p05-asset-manifest.schema.json",
  "title": "P05 Industrial Facility Asset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "asset_id", "display_name_zh", "category", "source_reference", "modular_kit", "pivot", "snap_grid_cm", "pbr", "lod", "collision", "deliverables"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "package_id": {"const": "P05_INDUSTRIAL_FACILITIES"},
    "asset_id": {"type": "string", "pattern": "^P05_IF_[A-Z0-9_]+$"},
    "display_name_zh": {"type": "string", "minLength": 1},
    "category": {"type": "string"},
    "source_reference": {
      "type": "object",
      "required": ["path", "usage"],
      "properties": {"path": {"const": "../source/generated_image_035559.png"}, "usage": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
    },
    "modular_kit": {"type": "object", "required": ["module_ids", "sockets"], "properties": {"module_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "sockets": {"type": "array", "items": {"type": "string"}}, "notes": {"type": "array", "items": {"type": "string"}}}},
    "pivot": {"type": "object", "required": ["rule", "orientation"], "properties": {"rule": {"type": "string"}, "orientation": {"type": "string"}}},
    "snap_grid_cm": {"type": "object", "required": ["translation", "rotation_deg"], "properties": {"translation": {"type": "number", "exclusiveMinimum": 0}, "rotation_deg": {"type": "number", "exclusiveMinimum": 0}, "fine_translation": {"type": "number", "exclusiveMinimum": 0}}},
    "pbr": {"type": "object", "required": ["material_slots", "metallic", "roughness", "texture_set"], "properties": {"material_slots": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "metallic": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}}, "roughness": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}}, "texture_set": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "special": {"type": "object"}}},
    "lod": {"type": "object", "required": ["triangle_budget", "screen_ratio"], "properties": {"triangle_budget": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0}}, "screen_ratio": {"const": [0.35, 0.16, 0.07, 0.025]}, "notes": {"type": "array", "items": {"type": "string"}}}},
    "collision": {"type": "object", "required": ["mode", "budget", "rules"], "properties": {"mode": {"enum": ["none", "simple_box", "simple_capsule", "simple_convex", "compound", "proxy_only"]}, "budget": {"type": "object"}, "rules": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "deliverables": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}