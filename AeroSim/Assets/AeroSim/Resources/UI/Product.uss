.app-root { min-width: 0; min-height: 0; }
.main-content { min-width: 0; }
.nav-label { font-size: 14px; flex-shrink: 1; white-space: normal; }
.side-nav { min-height: 0; }
.side-nav .unity-scroll-view__content-container { flex-grow: 1; }
.top-settings .icon-button-label { font-size: 12px; }
.product-scroll { flex-grow: 1; padding-left: 32px; padding-right: 32px; padding-top: 28px; padding-bottom: 28px; }
.product-scroll .unity-scroller { width: 8px; }
.product-scroll .unity-scroller__low-button { display: none; }
.product-scroll .unity-scroller__high-button { display: none; }
.product-scroll .unity-scroller .unity-base-slider__dragger { background-color: rgb(57, 89, 111); border-radius: 4px; }
.product-scroll .unity-scroller .unity-base-slider__tracker { background-color: rgb(8, 24, 38); }
.page-eyebrow { color: rgb(30, 206, 234); font-size: 12px; -unity-font-style: bold; margin-bottom: 10px; letter-spacing: 2px; }
.page-title { font-size: 36px; -unity-font-style: bold; margin-bottom: 12px; white-space: normal; }
.page-subtitle { color: rgb(163, 191, 211); font-size: 16px; margin-bottom: 26px; max-width: 1050px; }
.wrap { white-space: normal; }
.muted { color: rgb(159, 186, 207); font-size: 14px; margin-top: 8px; margin-bottom: 12px; }
.product-panel { background-color: rgb(12, 36, 55); border-width: 1px; border-color: rgb(32, 64, 86); border-radius: 14px; padding-left: 24px; padding-right: 24px; padding-top: 22px; padding-bottom: 22px; margin-bottom: 18px; flex-grow: 1; min-width: 0; }
.panel-title { font-size: 22px; -unity-font-style: bold; margin-bottom: 10px; white-space: normal; }
.product-row { flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: 10px; }
.product-grid { flex-direction: row; flex-wrap: wrap; }
.product-grid .product-panel { width: 45%; margin-right: 18px; min-width: 270px; }
.action-button { background-color: rgb(22, 53, 75); border-width: 1px; border-color: rgb(54, 89, 114); border-radius: 8px; min-height: 44px; padding-left: 16px; padding-right: 16px; padding-top: 8px; padding-bottom: 8px; margin-right: 10px; margin-top: 6px; margin-bottom: 6px; font-size: 15px; white-space: normal; }
.action-button:hover { background-color: rgb(35, 75, 104); }
.action-button:active { background-color: rgb(15, 118, 181); }
.action-button:focus { border-color: rgb(90, 217, 255); border-width: 2px; }
.primary-button { min-height: 44px; margin-right: 10px; margin-top: 6px; margin-bottom: 6px; white-space: normal; }
.primary-button:disabled { opacity: 0.45; }
.product-field { margin-top: 10px; margin-bottom: 12px; min-height: 32px; }
.product-field .unity-base-field__label { min-width: 215px; color: rgb(201, 222, 237); white-space: normal; }
.product-field .unity-base-field__input { background-color: rgb(5, 24, 40); color: rgb(240, 247, 255); min-height: 36px; border-radius: 5px; border-width: 1px; border-color: rgb(58, 92, 114); }
.product-field .unity-base-text-field__input { padding-left: 10px; padding-right: 10px; }
.product-field .unity-text-element { color: rgb(231, 244, 255); }
.product-field .unity-slider__input { background-color: rgba(0,0,0,0); border-width: 0; }
.product-field .unity-toggle__input { background-color: rgba(0,0,0,0); border-width: 0; }
.unity-base-popup-field__menu { background-color: rgb(20, 48, 70); color: white; }
.unity-base-popup-field__item { color: white; }
.stat { padding-left: 4px; padding-right: 32px; margin-bottom: 10px; min-width: 150px; }
.stat-value { font-size: 34px; -unity-font-style: bold; color: rgb(52, 212, 245); }
.scene-banner { height: 180px; border-radius: 10px; margin-top: 12px; margin-bottom: 16px; }
.axis-label { font-size: 15px; margin-top: 12px; margin-bottom: 4px; }
.response-curve { height: 150px; background-color: rgb(5, 24, 39); border-radius: 8px; margin-top: 14px; margin-bottom: 14px; }
.osd-preview { height: 360px; position: relative; border-radius: 8px; margin-bottom: 22px; }
.osd-token { position: absolute; color: white; background-color: rgba(0, 15, 28, 0.8); padding-left: 10px; padding-right: 10px; padding-top: 8px; padding-bottom: 8px; border-width: 1px; border-color: rgb(47, 217, 240); border-radius: 5px; font-size: 20px; -unity-font-style: bold; }
.event-row { border-bottom-width: 1px; border-bottom-color: rgb(32, 67, 89); padding-top: 12px; padding-bottom: 12px; color: rgb(190, 221, 240); }
.high-contrast .product-panel { background-color: rgb(0, 13, 23); border-color: rgb(171, 208, 232); }
.high-contrast .muted { color: rgb(224, 239, 250); }
.high-contrast .page-subtitle { color: rgb(224, 239, 250); }
.large-text { font-size: 19px; }
.large-text .muted { font-size: 17px; }
.large-text .page-subtitle { font-size: 19px; }
.large-text .action-button { font-size: 18px; }
.large-text .product-field { font-size: 18px; }
.flight-root { background-color: rgba(0, 0, 0, 0); }
.flight-hud { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.flight-bar { position: absolute; left: 0; right: 0; top: 0; height: 64px; flex-direction: row; align-items: center; padding-left: 24px; padding-right: 24px; background-color: rgba(3, 20, 34, 0.86); }
.flight-brand { font-size: 16px; -unity-font-style: bold; color: rgb(95, 225, 249); margin-right: 30px; }
.flight-status { flex-grow: 1; font-size: 16px; white-space: normal; }
.objective-card { position: absolute; left: 24px; top: 80px; width: 400px; border-radius: 10px; padding-left: 18px; padding-right: 18px; padding-top: 16px; padding-bottom: 16px; background-color: rgba(4, 22, 36, 0.82); }
.hud-metric { position: absolute; min-width: 110px; padding-left: 14px; padding-right: 14px; padding-top: 10px; padding-bottom: 10px; background-color: rgba(4, 22, 36, 0.72); border-radius: 8px; }
.hud-caption { font-size: 11px; color: rgb(161, 206, 226); margin-bottom: 6px; }
.hud-value { font-size: 26px; -unity-font-style: bold; }
.warning-text { color: rgb(255, 154, 77); }
.input-readout { position: absolute; left: 38%; top: 70px; font-size: 12px; background-color: rgba(0, 16, 29, 0.65); padding-left: 10px; padding-right: 10px; padding-top: 8px; padding-bottom: 8px; border-radius: 5px; }
.mini-map { position: absolute; width: 170px; height: 150px; right: 24px; top: 90px; border-radius: 10px; background-color: rgba(1, 17, 29, 0.8); border-width: 1px; border-color: rgb(94, 159, 183); }
.flight-bottom { position: absolute; left: 0; right: 0; bottom: 0; min-height: 68px; flex-direction: row; align-items: center; justify-content: center; padding-left: 12px; padding-right: 12px; background-color: rgba(3, 20, 34, 0.86); }
.flight-guidance { position: absolute; bottom: 80px; left: 27%; right: 27%; -unity-text-align: middle-center; font-size: 12px; color: rgb(203, 235, 246); background-color: rgba(0, 17, 29, 0.65); padding-top: 8px; padding-bottom: 8px; border-radius: 5px; }
.touch-stick { position: absolute; bottom: 115px; width: 140px; height: 140px; border-radius: 70px; border-width: 2px; border-color: rgba(177, 226, 239, 0.75); background-color: rgba(3, 29, 45, 0.25); justify-content: center; align-items: center; }
.stick-left { left: 40px; }
.stick-right { right: 40px; }
.stick-knob { width: 45px; height: 45px; border-radius: 23px; background-color: rgba(154, 222, 241, 0.65); border-width: 1px; border-color: white; }
.stick-caption { position: absolute; top: 150px; left: -15px; right: -15px; -unity-text-align: middle-center; font-size: 12px; color: white; }
.modal-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(1, 12, 22, 0.75); justify-content: center; align-items: center; }
.modal-overlay .product-panel { width: 540px; max-width: 90%; flex-grow: 0; }
.replay-slider { flex-grow: 1; max-width: 650px; margin-left: 16px; margin-right: 16px; }
.layout-phone .product-scroll { padding-left: 14px; padding-right: 14px; padding-top: 18px; }
.layout-phone .page-title { font-size: 27px; }
.layout-phone .product-panel { padding-left: 14px; padding-right: 14px; }
.layout-phone .primary-button { width: auto; max-width: 100%; min-width: 150px; padding-left: 16px; padding-right: 16px; }
.layout-phone .controller-card { min-width: 0; }
.layout-phone .readiness-card { min-width: 0; }
.layout-phone .hero-copy { width: 100%; padding-left: 18px; padding-right: 18px; }
.layout-phone .hero-description { width: 100%; }
.layout-phone .hero-title { font-size: 28px; white-space: normal; }
.layout-phone .hero-metrics { flex-wrap: wrap; }
.layout-phone .workspace-menu { left: 6px; right: 6px; width: auto; }
.layout-phone .product-grid .product-panel { width: 100%; min-width: 0; margin-right: 0; }
.layout-phone .product-field { flex-direction: column; }
.layout-phone .product-field .unity-base-field__label { min-width: 0; margin-bottom: 8px; }
.layout-phone .side-nav .action-button { font-size: 10px; padding-left: 0; padding-right: 0; margin-right: 0; }
.layout-phone .nav-button { padding-left: 6px; padding-right: 4px; }
.layout-phone .flight-brand { font-size: 11px; margin-right: 12px; }
.layout-phone .objective-card { width: 240px; top: 72px; left: 12px; font-size: 13px; }
.layout-phone .objective-card { max-height: 86px; overflow: hidden; padding-top: 8px; padding-bottom: 8px; }
.layout-phone .objective-card .wrap { max-height: 42px; overflow: hidden; }
.layout-phone .mini-map { width: 100px; height: 95px; right: 12px; top: 74px; }
.layout-phone .input-readout { display: none; }
.layout-phone .touch-stick { width: 100px; height: 100px; bottom: 90px; }
.layout-phone .stick-caption { top: 105px; font-size: 10px; }
.layout-phone .stick-left { left: 20px; }
.layout-phone .stick-right { right: 20px; }
.layout-phone .flight-guidance { display: none; }
.layout-phone .flight-bottom { flex-wrap: wrap; }
.layout-phone .flight-bottom .action-button { font-size: 12px; padding-left: 8px; padding-right: 8px; margin-right: 4px; }
.layout-phone .hud-value { font-size: 18px; }
.layout-phone .hud-metric { min-width: 80px; padding-left: 8px; padding-right: 8px; }
.layout-phone .speed-metric { left: 55%; top: 48%; }
.layout-phone .altitude-metric { left: 25%; top: 48%; }
.layout-phone .timer-metric { left: 50%; top: 28%; }
.layout-phone .battery-metric { left: 76%; top: 28%; }
.layout-phone .flight-bottom .primary-button { font-size: 13px; min-width: 120px; min-height: 44px; }
.is-hidden { display: none; }
